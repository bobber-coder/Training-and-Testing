# Lionheart Finance Agent — environment template
# Copy to `.env` on your Mac and fill in real values. NEVER commit `.env`.
# These names are referenced by the Hermes skills + helper scripts.

# ----- Zoho Books (OAuth2 self-client) -----
# Create at https://api-console.zoho.com  → Self Client.
# Region matters: Canada orgs use the .com data center unless told otherwise.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
ZOHO_API_DOMAIN=https://www.zohoapis.com      # e.g. .com / .ca / .eu — confirm your DC
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com # token refresh endpoint host

# ----- Google Sheets (service account) -----
# Share the target Sheet with the service-account email as Editor.
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/google-service-account.json
LIONHEART_SHEET_ID=

# ----- LLM provider for the helper scripts (vision fallback / testing) -----
# Hermes itself uses its own configured provider; this is only for local script tests.
ANTHROPIC_API_KEY=

# ----- Stripe (optional, for auto-mark-paid) -----
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# ----- Repo location on the Mac (so skills can find the shared helper scripts) -----
# Set this to the absolute path where you cloned this repo.
LIONHEART_DIR=/Users/you/lionheart-finance-agent

# ----- Business / tax config (Canada sole proprietor) -----
BUSINESS_NAME=LXR Productions     # shown on invoices/estimates/dossier (aka "Lionheart")
HOME_CURRENCY=CAD
GST_HST_REGISTERED=false          # flip to true once you register / cross $30k
GST_HST_NUMBER=
FISCAL_YEAR_START=01-01
